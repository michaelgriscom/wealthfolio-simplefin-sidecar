// Parsed as JSONC: comments and trailing commas are allowed. Account ids are
// opaque on both sides, so label each entry — you will not remember which is
// which later.
{
  "simplefinAccessUrl": "https://USERNAME:PASSWORD@bridge.simplefin.org/simplefin",
  "exchangeMic": "XNAS",

  // Optional: SimpleFIN accounts holding crypto. Crypto holdings sync as
  // CRYPTO instruments (Wealthfolio prices them as e.g. BTC-USD) instead of
  // equities on `exchangeMic`. Use "all" when every holding is crypto, or list
  // the crypto tickers for an account that also holds stocks.
  "cryptoAccounts": {
    "<coinbase-wallet-simplefin-account-id>": "all", // Coinbase: list every wallet
    "<mixed-broker-simplefin-account-id>": ["BTC", "ETH"], // stocks + crypto
  },

  // Wealthfolio account id -> the SimpleFIN account ids feeding it.
  // Every Wealthfolio account listed here must use HOLDINGS tracking mode.
  "mapping": {
    // Vanguard — Roth IRA
    "<wealthfolio-account-id>": ["<simplefin-account-id>"],

    // Fidelity — HSA + 529 aggregated into a single Wealthfolio account
    "<another-wealthfolio-account-id>": [
      "<simplefin-account-id>", // HSA
      "<second-simplefin-account-id-to-aggregate>", // 529
    ],
  },
}
